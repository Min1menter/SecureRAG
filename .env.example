LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Only needed for Groq (LLM_PROVIDER=groq)
GROQ_API_KEY=

# Retrieval tuning (see README -> Evaluate it)
# TOP_K=6
# RERANKER_ENABLED=true
# MIN_RERANK_SCORE=0.05
# MIN_DENSE_SIMILARITY=0.25

# Answer style
# MAX_TOKENS=1500
# TEMPERATURE=0.3

# Security
# INJECTION_ACTION=flag      # flag | drop
# REDACT_CONTEXT=auto        # auto (only for remote LLMs) | true | false
# MAX_FILE_SIZE_MB=25
